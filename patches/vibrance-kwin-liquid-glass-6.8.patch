+void BlurEffect::setLiquidSurface(SurfaceInterface *surface, std::span<const uint32_t> words)
+{
+    auto &request = liquidSurfaces[surface];
+    if (!request) {
+        request = std::make_unique<LiquidSurface>(this, surface);
+        connect(surface, &SurfaceInterface::aboutToBeDestroyed, this, [this, surface] {
+            liquidSurfaces.erase(surface);
+        });
+    }
+    auto &pending = request->pending->words.emplace();
+    if (!words.empty())
+        pending.assign(words.begin(), words.end());
+}
