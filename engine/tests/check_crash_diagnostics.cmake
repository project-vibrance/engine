foreach(mode abort terminate worker worker-reinitialise worker-reconfigure worker-no-filter native reentrant)
    string(TIMESTAMP timestamp "%Y%m%d-%H%M%S" UTC)
    string(RANDOM LENGTH 8 run)
    set(directory "${OUTPUT_DIRECTORY}/${timestamp}-${run}-${mode}")
    file(MAKE_DIRECTORY "${directory}")
    execute_process(COMMAND "${LOGGER_TEST}" "--crash-${mode}" "${directory}"
        RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET TIMEOUT 15)
    if(result STREQUAL "0" OR result MATCHES "timeout")
        message(FATAL_ERROR "Crash fixture ${mode} did not terminate as expected: ${result}")
    endif()
    file(GLOB reports "${directory}/*.crash.txt")
    if(NOT reports)
        message(FATAL_ERROR "No emergency report for ${mode}")
    endif()
    set(contents "")
    foreach(report IN LISTS reports)
        file(READ "${report}" report_contents)
        string(APPEND contents "${report_contents}")
    endforeach()
    if(NOT contents MATCHES "FATAL CRASH")
        message(FATAL_ERROR "Emergency report is empty for ${mode}")
    endif()
    if((mode STREQUAL "terminate" OR mode MATCHES "^worker") AND
        (NOT contents MATCHES "std::terminate" OR NOT contents MATCHES "worker crash fixture"))
        message(FATAL_ERROR "The termination report lost the worker exception reason: ${contents}")
    endif()
    if(mode STREQUAL "native" OR mode STREQUAL "reentrant")
        file(GLOB dumps "${directory}/*.dmp")
        if(NOT contents MATCHES "0xC0000005" OR NOT contents MATCHES "Fault module: .+ \\+ 0x" OR NOT dumps)
            message(FATAL_ERROR "Native exception details or minidump are missing: ${contents}")
        endif()
        string(REGEX MATCHALL "FATAL CRASH: Windows exception" native_reports "${contents}")
        list(LENGTH native_reports native_report_count)
        if(NOT native_report_count EQUAL 1)
            message(FATAL_ERROR "A secondary native fault replaced the first crash: ${contents}")
        endif()
        if(mode STREQUAL "reentrant")
            list(GET dumps 0 dump)
            file(READ "${dump}" dump_contents)
            if(NOT dump_contents STREQUAL "first crash dump fixture")
                message(FATAL_ERROR "A re-entrant dump writer overwrote the first dump")
            endif()
        endif()
    endif()
endforeach()
