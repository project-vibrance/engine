@PACKAGE_INIT@

set(vibrance_engine_VERSION "@PROJECT_VERSION@")
set(vibrance_engine_TARGET_PLATFORM "@VIBRANCE_TARGET_PLATFORM@")
set(vibrance_engine_WIN32_COMPOSITION_DLL
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/vibrance_win32_composition.dll")
set(vibrance_engine_WIN32_INTEROP_DLL
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/vibrance_win32_interop.dll")
set(vibrance_engine_RUNTIME_COMPANIONS "")
if(WIN32)
    foreach(_vibrance_engine_companion IN ITEMS
        "${vibrance_engine_WIN32_COMPOSITION_DLL}"
        "${vibrance_engine_WIN32_INTEROP_DLL}")
        if(EXISTS "${_vibrance_engine_companion}")
            list(APPEND
                vibrance_engine_RUNTIME_COMPANIONS
                "${_vibrance_engine_companion}")
        endif()
    endforeach()
    unset(_vibrance_engine_companion)
endif()
set_and_check(
    vibrance_engine_MANIFEST_FILE
    "@PACKAGE_CMAKE_INSTALL_DATADIR@/vibrance_engine/vibrance_engine_manifest.json")

include("${CMAKE_CURRENT_LIST_DIR}/vibrance_engineTargets.cmake")

if(WIN32)
    if(CMAKE_CXX_COMPILER_ARCHITECTURE_ID MATCHES "^(ARM64|arm64|aarch64)$" OR
       CMAKE_SYSTEM_PROCESSOR MATCHES "^(ARM64|arm64|aarch64)$")
        set(_vibrance_engine_consumer_platform windows-arm64)
    else()
        set(_vibrance_engine_consumer_platform windows-x64)
    endif()
    if(NOT "${_vibrance_engine_consumer_platform}" STREQUAL
       "${vibrance_engine_TARGET_PLATFORM}")
        message(FATAL_ERROR
            "The selected Vibrance engine SDK targets "
            "${vibrance_engine_TARGET_PLATFORM}, but this consumer targets "
            "${_vibrance_engine_consumer_platform}. Select the matching SDK prefix.")
    endif()
    unset(_vibrance_engine_consumer_platform)
endif()

if(NOT COMMAND vibrance_engine_copy_runtime_companions)
    function(vibrance_engine_copy_runtime_companions target_name)
        if(NOT TARGET "${target_name}")
            message(FATAL_ERROR
                "vibrance_engine_copy_runtime_companions: unknown target '${target_name}'")
        endif()
        set(_vibrance_engine_copy_target
            "${target_name}_vibrance_runtime_companions")
        if(NOT TARGET "${_vibrance_engine_copy_target}")
            add_custom_target(
                "${_vibrance_engine_copy_target}"
                ALL)
            # A consumer executable does not necessarily relink when only an
            # imported runtime DLL changes. Refresh the engine itself from this
            # always-built target without adding a generator expression to the
            # concrete-path runtime companion metadata used by packagers.
            add_custom_command(
                TARGET "${_vibrance_engine_copy_target}"
                POST_BUILD
                COMMAND "${CMAKE_COMMAND}" -E copy_if_different
                    "$<TARGET_FILE:vibrance::engine>"
                    "$<TARGET_FILE_DIR:${target_name}>"
                VERBATIM)
            foreach(_vibrance_engine_companion IN LISTS vibrance_engine_RUNTIME_COMPANIONS)
                add_custom_command(
                    TARGET "${_vibrance_engine_copy_target}"
                    POST_BUILD
                    COMMAND "${CMAKE_COMMAND}" -E copy_if_different
                        "${_vibrance_engine_companion}"
                        "$<TARGET_FILE_DIR:${target_name}>"
                    VERBATIM)
            endforeach()
            add_dependencies(
                "${target_name}"
                "${_vibrance_engine_copy_target}")
        endif()
        unset(_vibrance_engine_copy_target)
    endfunction()
endif()

check_required_components(vibrance_engine)
