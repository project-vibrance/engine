# Replace a runtime that an older DWM extension may still have mapped. Never
# silently package a stale DLL, and keep the mapped image until its owner exits.
function(vibrance_copy_locked_runtime source destination)
    get_filename_component(destination_directory "${destination}" DIRECTORY)
    file(MAKE_DIRECTORY "${destination_directory}")
    file(COPY_FILE "${source}" "${destination}" ONLY_IF_DIFFERENT RESULT copy_result)
    if(copy_result STREQUAL "0")
        return()
    endif()
    if(NOT WIN32 OR NOT EXISTS "${destination}")
        message(FATAL_ERROR "Cannot deploy ${source} to ${destination}: ${copy_result}")
    endif()

    string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef replacement_id)
    set(staged "${destination}.replacement-${replacement_id}")
    set(retained "${destination}.in-use-${replacement_id}")
    file(COPY_FILE "${source}" "${staged}" RESULT stage_result)
    if(NOT stage_result STREQUAL "0")
        message(FATAL_ERROR "Cannot stage ${source}: ${stage_result}")
    endif()
    file(RENAME "${destination}" "${retained}" RESULT retain_result)
    if(NOT retain_result STREQUAL "0")
        file(REMOVE "${staged}")
        message(FATAL_ERROR "Cannot retain the locked runtime ${destination}: ${retain_result}")
    endif()
    file(RENAME "${staged}" "${destination}" RESULT replace_result)
    if(NOT replace_result STREQUAL "0")
        file(RENAME "${retained}" "${destination}" RESULT restore_result)
        file(REMOVE "${staged}")
        message(FATAL_ERROR "Cannot replace ${destination}: ${replace_result}; restore: ${restore_result}")
    endif()
    message(STATUS "Installed ${destination}; retained the mapped image at ${retained}")
endfunction()

function(vibrance_install_locked_runtime source destination)
    file(TO_CMAKE_PATH "${source}" source)
    file(TO_CMAKE_PATH "${destination}" destination)
    get_filename_component(runtime_name "${source}" NAME)
    if(IS_ABSOLUTE "${destination}")
        set(install_directory "\$ENV{DESTDIR}${destination}")
    else()
        set(install_directory "\$ENV{DESTDIR}\${CMAKE_INSTALL_PREFIX}/${destination}")
    endif()
    # Resolve the install prefix at installation time, including --prefix and
    # DESTDIR overrides. Capture the helper path while configuring the caller.
    install(CODE "
        include(\"${CMAKE_CURRENT_FUNCTION_LIST_FILE}\")
        vibrance_copy_locked_runtime(\"${source}\"
            \"${install_directory}/${runtime_name}\")
    ")
endfunction()

if(DEFINED VIBRANCE_RUNTIME_SOURCE AND DEFINED VIBRANCE_RUNTIME_DESTINATION)
    vibrance_copy_locked_runtime("${VIBRANCE_RUNTIME_SOURCE}" "${VIBRANCE_RUNTIME_DESTINATION}")
endif()
